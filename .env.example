APP_ENV=development
APP_LOG_LEVEL=INFO
APP_API_PREFIX=/api/v1
APP_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PORT=18000

DATABASE_URL=postgresql+psycopg://clinical:clinical@localhost:55432/clinical

OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=clinical-artifacts
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_PATH_STYLE=true

JWT_ISSUER=https://local-issuer.example
JWT_AUDIENCE=clinical-artifact-platform
JWT_JWKS_URL=http://localhost:18081/.well-known/jwks.json
JWT_ALGORITHMS=RS256

# Shared control plane. Use shadow during reconciliation, then enforced.
PLATFORM_CONTROL_PLANE_URL=http://localhost:8002
PLATFORM_AUTHORIZATION_MODE=disabled
PLATFORM_SERVICE_TOKEN_URL=http://localhost:18081/token
PLATFORM_SERVICE_CLIENT_ID=aurinara-api
PLATFORM_SERVICE_CLIENT_SECRET=CHANGE-ME
PLATFORM_SERVICE_AUDIENCE=aurinara-platform
PLATFORM_SERVICE_SCOPE=https://aurinara-platform.local/service
PLATFORM_SERVICE_RESOURCE=https://aurinara-platform.local
PLATFORM_AUTHORIZATION_TIMEOUT_SECONDS=2
PLATFORM_AUTHORIZATION_CACHE_SECONDS=30
PLATFORM_EVENT_QUEUE_URL=http://127.0.0.1:4567/000000000000/aurinara-platform-events
PLATFORM_EVENT_REGION=us-east-1
PLATFORM_EVENT_ENDPOINT_URL=http://127.0.0.1:4567
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# Browser authorization-code + PKCE client (public client, no secret).
VITE_OIDC_AUTHORIZE_URL=https://issuer.example/oauth2/authorize
VITE_OIDC_TOKEN_URL=https://issuer.example/oauth2/token
VITE_OIDC_CLIENT_ID=aurinara-spa
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_SCOPES=openid profile email

# Development-only local JWT issuer. Never enable this in production.
DEV_JWT_ENABLED=true
DEV_JWT_ISSUER=https://local-issuer.example
DEV_JWT_AUDIENCE=clinical-artifact-platform

# Host port for Compose's development-only JWT issuer.
DEV_JWT_PORT=18081

JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3

INTEGRATION_DELIVERY_ENABLED=true
INTEGRATION_MAX_ATTEMPTS=5
INTEGRATION_REQUEST_TIMEOUT_SECONDS=10
INTEGRATION_RESPONSE_LIMIT_BYTES=65536
INTEGRATION_EVENT_MAX_BYTES=65536
INTEGRATION_ALLOW_LOOPBACK_CALLBACKS=true
INTEGRATION_SECRET_ENCRYPTION_KEY=development-only-change-me

# Used only by the offline CDISC Library snapshot command; never stored by the application.
CDISC_LIBRARY_BASE_URL=https://library.cdisc.org/api
CDISC_LIBRARY_API_KEY=dd588ca02c014eb79d4c4697d70a2034
CDISC_LIBRARY_TIMEOUT_SECONDS=30
CDISC_LIBRARY_MAX_RESOURCES=250000
CDISC_LIBRARY_PARALLEL_REQUESTS=12

EXECUTOR_ADAPTER=docker
EXECUTION_NETWORK_DISABLED=true
EXECUTION_CPU_LIMIT=2
EXECUTION_MEMORY_MB=4096
EXECUTION_TIMEOUT_SECONDS=1800
EXECUTION_OUTPUT_LIMIT_BYTES=1073741824
EXECUTION_LOG_LIMIT_BYTES=1048576
PYTHON_RUNNER_IMAGE=aurinara-python-runner:local
R_RUNNER_IMAGE=aurinara-r-runner:local
# SAS_RUNNER_ADAPTER is intentionally unset unless an external adapter is configured.
