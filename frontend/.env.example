# Aurinara API proxied by the Vite development server.
VITE_API_PROXY_TARGET=http://127.0.0.1:18000

# Central Repository API called directly with the signed-in user's token.
VITE_PLATFORM_API_BASE_URL=http://localhost:8002
# Optional when VITE_PLATFORM_API_BASE_URL is blank; Vite proxies /v1 here.
VITE_PLATFORM_PROXY_TARGET=http://localhost:8002

# Browser authorization-code + PKCE client. Production uses Cognito managed login.
VITE_OIDC_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE
VITE_OIDC_CLIENT_ID=aurinara-spa
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_LOGOUT_URI=http://localhost:5173/login
VITE_OIDC_END_SESSION_ENDPOINT=https://example.auth.us-east-1.amazoncognito.com/logout
VITE_OIDC_SCOPES=openid profile email
